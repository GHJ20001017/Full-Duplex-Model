        "narrative": "Carlyn was surprised to learn that he had never met Brion. He had assumed that they had met before, since they lived in the same town. However, upon further reflection, Carlyn realized that he had never actually seen Brion before.",
        "speakers": [
          "Carlyn",
          "Brion"
        ],
        "behaviors": [
          {
            "utterance_length": 0,
            "filler_words": 0,
            "backchannels": 0,
            "interruptions": 0
          },
          {
            "utterance_length": 1,
            "filler_words": 0,
            "backchannels": 0,
            "interruptions": 0
          }
        ],
        "num_turns": 8,
        "utterances": [
          {
            "uttr_idx": 0,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Carlyn",
            "tts_text": "Hi, Brion. It’s surprising we’ve never met before.",
            "dur_samples": 101632,
            "start_time": 0.0,
            "end_time": 4.609160997732427,
            "backchannels": []
          },
          {
            "uttr_idx": 1,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "Hi, Carlyn. It is surprising, especially since we live in the same town. I feel like I’ve heard your name a few times.",
            "dur_samples": 164801,
            "start_time": 4.946802721088435,
            "end_time": 12.420770975056689,
            "backchannels": []
          },
          {
            "uttr_idx": 2,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Carlyn",
            "tts_text": "Same here. I assumed we had met at some point.",
            "dur_samples": 74564,
            "start_time": 12.966530612244897,
            "end_time": 16.3481179138322,
            "backchannels": []
          },
          {
            "uttr_idx": 3,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "Yeah, I’ve thought the same. It’s strange how you just assume these things sometimes. Have you always lived here?",
            "dur_samples": 158083,
            "start_time": 16.791655328798186,
            "end_time": 23.96095238095238,
            "backchannels": []
          },
          {
            "uttr_idx": 4,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Carlyn",
            "tts_text": "Yes, born and raised.",
            "dur_samples": 31044,
            "start_time": 24.181133786848072,
            "end_time": 25.58902494331066,
            "backchannels": []
          },
          {
            "uttr_idx": 5,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Carlyn",
            "tts_text": "Haven't moved out.",
            "dur_samples": 34530,
            "start_time": 25.58902494331066,
            "end_time": 27.15501133786848,
            "backchannels": []
          },
          {
            "uttr_idx": 6,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "Wow, me too!",
            "dur_samples": 23764,
            "start_time": 27.15501133786848,
            "end_time": 28.232743764172337,
            "backchannels": []
          },
          {
            "uttr_idx": 7,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "We must’ve crossed paths somewhere, but I guess not officially.",
            "dur_samples": 121088,
            "start_time": 28.232743764172337,
            "end_time": 33.724263038548756,
            "backchannels": []
          },
          {
            "uttr_idx": 8,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "Small world, huh?",
            "dur_samples": 32512,
            "start_time": 33.724263038548756,
            "end_time": 35.19873015873016,
            "backchannels": []
          },
          {
            "uttr_idx": 9,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Carlyn",
            "tts_text": "Very small. Nice meeting you at last.",
            "dur_samples": 62720,
            "start_time": 35.781360544217684,
            "end_time": 38.62580498866213,
            "backchannels": []
          },
          {
            "uttr_idx": 10,
            "uttr_type": null,
            "speaker_idx": 1,
            "speaker": "Brion",
            "tts_text": "Nice to meet you too, Carlyn.",
            "dur_samples": 34435,
            "start_time": 39.25120181405896,
            "end_time": 40.812879818594105,
            "backchannels": []
          },
          {
            "uttr_idx": 11,
            "uttr_type": null,
