          },
          {
            "uttr_idx": 15,
            "uttr_type": null,
            "speaker_idx": 0,
            "speaker": "Danna",
            "tts_text": "It's an integral part of building a dynamic and forward-thinking team.",
            "dur_samples": 100864,
